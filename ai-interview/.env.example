# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，密钥不入库）
# MySQL root 密码（backend 数据源与 mysql 容器共用）
MYSQL_PASSWORD=root123456
# JWT 签名密钥（≥32 字节；生产必须更换）
JWT_SECRET=m6-demo-jwt-secret-please-change-in-production!!
# AI Provider：mock=离线演示（默认）；qwen=真实大模型（需填 AI_API_URL/AI_API_KEY）
AI_PROVIDER=mock
AI_API_URL=
AI_API_KEY=
AI_MODEL=qwen-plus
